{
  "description": "Webcheck is a service that monitors websites and verifies web functionality. This custom Kasm image runs a Node.js application built from source.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "webcheck.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "yarn serve --cwd /web-check"
    },
    "assign": {
      "cmd": "yarn serve --cwd /web-check"
    }
  },
  "categories": [
    "Web Service"
  ],
  "friendly_name": "Webcheck",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "bukshee/webcheck-kasm:latest",
      "uncompressed_size_mb": 500,
      "available_tags": [
        "latest"
      ]
    }
  ]
}
